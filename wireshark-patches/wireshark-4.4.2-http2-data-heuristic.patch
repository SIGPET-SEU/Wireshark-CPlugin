+static int
+dissect_http2_data_heur_stream(tvbuff_t *tvb, packet_info *pinfo,
+                               proto_tree *tree, void *data)
+{
+    http2_data_info_t *data_info = (http2_data_info_t *)data;
+    conversation_t *conversation = find_or_create_conversation(pinfo);
+    http2_session_t *session = get_http2_session(pinfo, conversation);
+    http2_stream_info_t *stream_info = get_stream_info(pinfo, session, false);
+
+    if (stream_info->data_heuristic == NULL)
+        return 0;
+    data_info->probe = false;
+    call_heur_dissector_direct(stream_info->data_heuristic, tvb, pinfo, tree,
+                               data_info);
+    return tvb_captured_length(tvb);
